---
import { render } from 'astro:content';
import Asos from '../../layouts/Asos.astro';
import { SAYT } from '../../data/sayt';
import { mavzuTop } from '../../data/mavzular';
import { BOGLIQ } from '../../data/bogliq';
import {
  barchaMaqolalar,
  maqolaYoli,
  oqishVaqti,
  sanaMatn,
  type Maqola,
} from '../../lib/maqolalar';

export async function getStaticPaths() {
  const maqolalar = await barchaMaqolalar();
  return maqolalar.map((maqola) => ({ params: { slug: maqola.id }, props: { maqola } }));
}

interface Props {
  maqola: Maqola;
}

const { maqola } = Astro.props;
const { Content, headings } = await render(maqola);
const { sarlavha, qisqacha, sana, yangilangan, manbalar } = maqola.data;
const mavzu = mavzuTop(maqola.data.mavzu);
const bolimlar = headings.filter((h) => h.depth === 2);
const daqiqa = oqishVaqti(maqola.body);

const hammasi = await barchaMaqolalar();
// Avval qo'lda belgilangan bog'liq maqolalar, keyin shu mavzudagi boshqalari.
const qolda = (BOGLIQ[maqola.id] ?? [])
  .map((id) => hammasi.find((m) => m.id === id))
  .filter((m): m is Maqola => Boolean(m));
const shuMavzu = hammasi.filter(
  (m) => m.data.mavzu === maqola.data.mavzu && m.id !== maqola.id && !qolda.includes(m),
);
const oxshash = [...qolda, ...shuMavzu].slice(0, 5);

const manzil = new URL(maqolaYoli(maqola), Astro.site).href;
const sayt = new URL('/', Astro.site).href;
const tashkilot = {
  '@type': 'Organization',
  '@id': `${sayt}#tashkilot`,
  name: SAYT.nom,
  url: sayt,
  logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).href },
  sameAs: [SAYT.telegram, SAYT.instagram],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: sarlavha,
      description: qisqacha,
      inLanguage: 'uz',
      url: manzil,
      mainEntityOfPage: manzil,
      image: new URL('/og.jpg', Astro.site).href,
      datePublished: sana.toISOString(),
      dateModified: (yangilangan ?? sana).toISOString(),
      articleSection: mavzu.nom,
      isAccessibleForFree: true,
      author: tashkilot,
      publisher: tashkilot,
      citation: manbalar.map((m) => m.matn),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SAYT.nom, item: sayt },
        {
          '@type': 'ListItem',
          position: 2,
          name: mavzu.nom,
          item: new URL(`/mavzular/${mavzu.slug}/`, Astro.site).href,
        },
        { '@type': 'ListItem', position: 3, name: sarlavha, item: manzil },
      ],
    },
  ],
};
---

<Asos sarlavha={sarlavha} tavsif={qisqacha} turi="article" tor>
  <Fragment slot="bosh">
    <meta property="article:published_time" content={sana.toISOString()} />
    <meta property="article:modified_time" content={(yangilangan ?? sana).toISOString()} />
    <meta property="article:section" content={mavzu.nom} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="maqola">
    <header class="sahifa-bosh" style="padding-bottom: 0">
      <a class="iz" href={`/mavzular/${mavzu.slug}/`}>{mavzu.nom}</a>
      <h1>{sarlavha}</h1>
      <p class="meta">
        <time datetime={sana.toISOString().slice(0, 10)}>{sanaMatn(sana)}</time> · {daqiqa} daqiqada
        o'qiladi
        {yangilangan && <> · yangilangan: {sanaMatn(yangilangan)}</>}
      </p>
    </header>

    <div class="qisqacha">
      <h2 class="yorliq">Qisqacha</h2>
      <p>{qisqacha}</p>
    </div>

    {
      bolimlar.length >= 2 && (
        <nav class="mundarija" aria-label="Mundarija">
          <h2 class="yorliq">Mundarija</h2>
          <ol>
            {bolimlar.map((b) => (
              <li>
                <a href={`#${b.slug}`}>{b.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="matn" data-maqola-matni>
      <Content />
    </div>

    {
      manbalar.length > 0 && (
        <section class="royxat manbalar" id="manbalar">
          <h2 class="yorliq">Manbalar</h2>
          <ol>
            {manbalar.map((m, i) => (
              <li id={`manba-${i + 1}`}>
                <span>
                  {m.matn}
                  {m.havola && (
                    <>
                      {' '}
                      <a href={m.havola} rel="noopener">
                        Havola
                      </a>
                    </>
                  )}
                </span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      oxshash.length > 0 && (
        <section class="royxat oxshash">
          <h2 class="yorliq">Bog'liq maqolalar</h2>
          {oxshash.map((m) => (
            <a href={maqolaYoli(m)}>{m.data.sarlavha}</a>
          ))}
        </section>
      )
    }
  </article>
</Asos>

<script>
  // Matndagi [1], [2] kabi raqamlarni pastdagi manbalar ro'yxatiga havolaga aylantiradi.
  const matn = document.querySelector('[data-maqola-matni]');
  if (matn) {
    const yuruvchi = document.createTreeWalker(matn, NodeFilter.SHOW_TEXT);
    const tugunlar: Text[] = [];
    while (yuruvchi.nextNode()) {
      const t = yuruvchi.currentNode as Text;
      if (/\[\d+(?:,\s*\d+)*\]/.test(t.data) && !t.parentElement?.closest('a, code, pre')) tugunlar.push(t);
    }
    for (const t of tugunlar) {
      // [1] yoki [1, 2] ko'rinishidagi ishoralar
      const qismlar = t.data.split(/(\[\d+(?:,\s*\d+)*\])/);
      const parcha = document.createDocumentFragment();
      for (const q of qismlar) {
        const mos = q.match(/^\[(\d+(?:,\s*\d+)*)\]$/);
        const raqamlar = mos ? mos[1].split(/,\s*/) : [];
        if (mos && raqamlar.every((r) => document.getElementById(`manba-${r}`))) {
          raqamlar.forEach((r, i) => {
            const a = document.createElement('a');
            a.href = `#manba-${r}`;
            a.className = 'manba-raqam';
            a.textContent = raqamlar.length === 1 ? `[${r}]` : `${i === 0 ? '[' : ''}${r}${i === raqamlar.length - 1 ? ']' : ''}`;
            a.setAttribute('aria-label', `${r}-manba`);
            if (i > 0) parcha.append(', ');
            parcha.append(a);
          });
        } else {
          parcha.append(q);
        }
      }
      t.replaceWith(parcha);
    }
  }
</script>
